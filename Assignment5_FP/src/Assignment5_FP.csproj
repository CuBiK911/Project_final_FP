<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="data/*.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="native/native_scoring.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="native_scoring.dll" />
    <None Update="native/libnative_scoring.so" CopyToOutputDirectory="PreserveNewest" TargetPath="libnative_scoring.so" />
  </ItemGroup>
</Project>
